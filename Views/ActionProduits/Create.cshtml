@model OutilRentabilite.Models.ActionProduit

<h3> Nouvelle action pour le produit</h3>

<form asp-action="Create" method="post">
  <input type="hidden" asp-for="ProduitFinancierId" />

  <div class="mb-3">
    <label>action</label>
    <select asp-for="TypeActionId" class="form-control" 
    asp-items="@(new SelectList(ViewBag.TypeAction, "Id", "Nom"))"></select>
  </div>
  <div class="mb-3">
    <label>coût</label>
    <select asp-for="EmployeId" class="form-control" 
    asp-items="@(new SelectList(ViewBag.Employes, "Id", "Nom"))"></select>
  </div>
    <div class="mb-3">
    <label>Nombre p.a</label>
    <input asp-for="MinutesParAction" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Enregistrer</button>
</form>