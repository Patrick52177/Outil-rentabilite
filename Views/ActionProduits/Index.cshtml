@model IEnumerable<OutilRentabilite.Models.ActionProduit>
@{
    var produit = ViewBag.Produit as OutilRentabilite.Models.ProduitFinancier;
}
<h3>Action du produit:: @produit.Nom</h3>
<table class="table table-bordered">
<thead class="table-dark">
 <tr>
   <th>Action</th>
   <th>Agent</th>
   <th>Nombre p.a</th>
   <th>Minute par trans.</th>
   <th>Coût calculé</th>
 </tr>
</thead>
<tbody>
@foreach (var a in Model){
     <tr>
   <td>@a.TypeAction.Nom</td>
   <td>@a.Employe.Nom</td>
   <td>@a.NomAction</td>
   <td>@a.MinutesParAction</td>
   <td>@a.CoutAction.ToString("N0")</td>
 </tr>
}

</tbody>
</table>