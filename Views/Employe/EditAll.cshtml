@model List<OutilRentabilite.Models.Employe>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<h2>Paramètre de coût personnel</h2>

<form asp-action="EditAll" method="post">
<table class="table table-bordered">
<thead class="table-dark">
 <tr>
   <th>Nom</th>
   <th>Base</th>
   <th>complément salaire</th>
   <th>assiduité</th>
   <th>fonction</th>
   <th>restauration</th>
   <th>entretien</th>
   <th>WU</th>
   <th>logement</th>
   <th>technicité</th>
   <th>transport</th>
   <th>caisse</th>
   <th>représentation</th>
   <th>responsabilité</th>
   <th>frais médicaux</th>
   <th>CSR</th>
   <th>OSIE</th>
   <th>CNaPS</th>
   <th>tickets PPN/bons d'achat</th>
   <th>aide scolaire</th>
   <th>voiture - amortissement</th>
   <th>carburant</th>
   <th>assurance</th>
    <th>dinde, … (fin d'année)</th>
     <th>téléphone</th>
    <th>gratification</th>
 </tr>
</thead>
<tbody>
   @for (int i = 0; i<Model.Count; i++){
    <tr>
       <td>@Model[i].Nom
       <input type="hidden" asp-for="@Model[i].Id"/>
       <input type="hidden" asp-for="@Model[i].Nom"/></td>
       <td><input asp-for="@Model[i].IndemniteBase" class="form-control"/>
       </td>
       <td><input asp-for="@Model[i].ComplementSalaire" class="form-control"/></td>
       <td><input asp-for="@Model[i].Assiduite" class="form-control"/></td> 
       <td><input asp-for="@Model[i].Fonction" class="form-control"/></td>
       <td><input asp-for="@Model[i].Restauration" class="form-control"/></td>
       <td><input asp-for="@Model[i].Entretien" class="form-control"/></td>
       <td><input asp-for="@Model[i].WU" class="form-control"/></td>
       <td><input asp-for="@Model[i].Logement" class="form-control"/></td>
       <td><input asp-for="@Model[i].Technicite" class="form-control"/></td>
       <td><input asp-for="@Model[i].Transport" class="form-control"/></td>
       <td><input asp-for="@Model[i].Caisse" class="form-control"/></td>
       <td><input asp-for="@Model[i].Representation" class="form-control"/></td>
       <td><input asp-for="@Model[i].Responsabilite" class="form-control"/></td>
       <td><input asp-for="@Model[i].FraisMedicaux" class="form-control"/></td>
       <td><input asp-for="@Model[i].CSR" class="form-control"/></td>
       <td><input asp-for="@Model[i].OSIE" class="form-control"/></td>
       <td><input asp-for="@Model[i].TicketsPPN" class="form-control"/></td>
       <td><input asp-for="@Model[i].AideScolaire" class="form-control"/></td>
       <td><input asp-for="@Model[i].VoitureAmortissement" class="form-control"/></td>
       <td><input asp-for="@Model[i].Carburant" class="form-control"/></td>
       <td><input asp-for="@Model[i].Assurance" class="form-control"/></td>
       <td><input asp-for="@Model[i].Autre" class="form-control"/></td>
       <td><input asp-for="@Model[i].Telephone" class="form-control"/></td>
       <td><input asp-for="@Model[i].Gratification" class="form-control"/></td>
    </tr>
   }
   </tbody>
   </table>
    <button type="submit" class="btn btn-success">Enregistrer</button>
    

</form>