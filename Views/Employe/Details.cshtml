@model OutilRentabilite.Models.Employe
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<h2>Détails de l’employé</h2>

<div class="card shadow-sm mb-3">
    <div class="card-header bg-primary text-white">
        <i class="bi bi-person-fill me-2"></i> @Model.Nom
    </div>
    <div class="card-body">
        <p><strong>Minutes disponibles/an :</strong> @Model.MinutesDisponiblesParAn</p>
        <p><strong>Coût annuel total :</strong> @Model.CoutAnnuelTotal.ToString("N0") Ar</p>
        <p><strong>Coût par minute :</strong> @Model.CoutParMinute.ToString("N4") Ar</p>
    </div>
</div>

<h4>Résumé des charges</h4>
<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Catégorie</th>
            <th>Montant (Ar)</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Indemnités</td>
            <td>
                @(Model.IndemniteBase + Model.ComplementSalaire + Model.Assiduite +
                  Model.Responsabilite + Model.Fonction + Model.Restauration +
                  Model.Entretien + Model.WU + Model.Logement + Model.Technicite +
                  Model.Transport + Model.Caisse + Model.Representation).ToString("N0") Ar
            </td>
        </tr>
        <tr>
            <td>Charges patronales</td>
            <td>
                @(Model.FraisMedicaux + Model.CSR + Model.OSIE + Model.CNaPS).ToString("N0") Ar
            </td>
        </tr>
        <tr>
            <td>Œuvres sociales</td>
            <td>
                @(Model.TicketsPPN + Model.AideScolaire + Model.VoitureAmortissement).ToString("N0") Ar
            </td>
        </tr>
        <tr class="table-dark">
            <td><strong>Total annuel</strong></td>
            <td><strong>@Model.CoutAnnuelTotal.ToString("N0") Ar</strong></td>
        </tr>
        <tr class="table-success">
            <td><strong>Coût par minute</strong></td>
            <td><strong>@Model.CoutParMinute.ToString("N4") Ar</strong></td>
        </tr>
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Modifier</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Supprimer</a>
    <a asp-action="Index" class="btn btn-secondary">Retour</a>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
}
